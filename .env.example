# Copia este archivo a .env y rellena los valores.

# Clave de API de Groq (paso de revaluación de relevancia).
GROQ_API_KEY=

# Modelo de Groq a usar (opcional; si se deja vacío se usa el valor por defecto).
GROQ_MODEL=openai/gpt-oss-120b

# Modelo de Groq para verificación (distinto de GROQ_MODEL).
GROQ_MODEL_VERIFICADOR=

# Cuenta de Gmail remitente (para send_email.py).
GMAIL_USER=

# Contraseña de aplicación de Gmail (no la contraseña normal).
GMAIL_APP_PASSWORD=

# Destinatarios del informe, separados por comas.
MAIL_TO=
