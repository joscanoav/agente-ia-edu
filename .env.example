# Copia este archivo a .env y rellena los valores.

# Clave de API de Groq (para el paso de LLM, aún no implementado).
GROQ_API_KEY=

# Modelo de Groq a usar.
GROQ_MODEL=openai/gpt-oss-120b

# Cuenta de Gmail remitente (para send_email.py).
GMAIL_USER=

# Contraseña de aplicación de Gmail (no la contraseña normal).
GMAIL_APP_PASSWORD=

# Destinatarios del informe, separados por comas.
MAIL_TO=
